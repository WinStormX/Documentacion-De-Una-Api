# ============================================================
#  Puesto de Chance API - Variables de entorno de ejemplo
#  Copiar este archivo como .env y ajustar los valores locales
# ============================================================

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto en el que escucha el servidor
PORT=3000

# Secreto para firmar los tokens JWT (CAMBIAR en producción)
JWT_SECRET=un-secreto-largo-y-dificil-de-adivinar
# Tiempo de vida del token (ej: 8h, 30m, 7d)
JWT_EXPIRES_IN=8h

# Zona horaria usada para calcular fechas de caja y vencimientos
ZONA_HORARIA=America/Bogota

# Minutos después de la venta en los que el vendedor puede anular un tiquete
MINUTOS_ANULACION=10
# Minutos antes del sorteo en los que se cierran las ventas
MINUTOS_CIERRE_VENTAS=15

# Topes de apuesta para chance (en pesos colombianos)
APUESTA_MIN_CHANCE=500
APUESTA_MAX_CHANCE=50000

# Valor de cada jugada de Baloto
VALOR_BALOTO=5700

# Días para reclamar un premio después del sorteo
DIAS_CADUCIDAD_PREMIO=365
